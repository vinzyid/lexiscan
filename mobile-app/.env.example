# Alamat backend Laravel. OPSIONAL - kalau kosong, aplikasi otomatis memakai
# IP mesin yang menjalankan Metro bundler (jalan di emulator maupun HP fisik,
# selama backend dijalankan dengan: php artisan serve --host=0.0.0.0).
# Isi kalau mengarah ke backend yang sudah ter-deploy:
# EXPO_PUBLIC_API_URL=https://api-lexyscan.pcremote.my.id

# Kunci endpoint AI, harus sama persis dengan AI_API_KEY di backend-api/.env.
# Lokal boleh nilai bebas: penjagaan di backend mati saat APP_ENV=local.
# Untuk build yang menunjuk backend ter-deploy, WAJIB diisi — kalau tidak,
# semua permintaan AI dijawab 401.
EXPO_PUBLIC_API_KEY=dev-local
