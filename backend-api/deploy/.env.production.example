# .env.production.example — template konfigurasi produksi LexiScan.
#
# Pakai:
#   cp deploy/.env.production.example .env.production
#   nano .env.production
#
# Berkas .env.production TIDAK boleh ikut ke Git. Pastikan sudah masuk
# .gitignore sebelum di-commit.

# --- Aplikasi --------------------------------------------------------------
APP_NAME=LexiScan
APP_ENV=production
APP_DEBUG=false

# Buat dengan:  php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

# Domain backend, sertakan https://
APP_URL=https://DOMAIN_BACKEND_ANDA

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# --- Log -------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database (Supabase pooler, WAJIB host pooler bukan direct) ------------
# Host db.<ref>.supabase.co hanya punya record IPv6 dan gagal di jaringan tanpa
# IPv6 ("could not translate host name"). Gunakan pooler:
DB_CONNECTION=pgsql
DB_HOST=aws-1-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=

# --- Penyimpanan & cache ---------------------------------------------------
# Berbasis file: endpoint AI hanya butuh cache dan rate limiter, tidak perlu
# bergantung pada database.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Penjagaan backend <-> aplikasi mobile (WAJIB di produksi) -------------
# Kalau kosong, endpoint AI menolak semua permintaan dengan 503.
# Nilainya harus SAMA PERSIS dengan EXPO_PUBLIC_API_KEY di mobile-app (eas.json).
# Buat dengan:  php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
AI_API_KEY=

# --- Penyedia AI -----------------------------------------------------------
AI_PROVIDER=gemini
AI_TIMEOUT=60

# Cadangan saat penyedia utama kehabisan jatah. Kosongkan untuk mematikannya.
AI_FALLBACK_PROVIDER=griphub

# Simpanan hasil AI (detik). Kosongkan agar disimpan selamanya -> hemat kuota.
AI_CACHE_TTL=

# Gemini - kunci gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Griphub Router - dipakai sebagai cadangan.
GRIPHUB_API_KEY=
GRIPHUB_MODEL=gemini-3.8-flash,deepseek-v4.1-flash

# Penyedia alternatif lain (isi kalau ingin berganti lewat AI_PROVIDER):
XAI_API_KEY=
XAI_MODEL=grok-4.5
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
