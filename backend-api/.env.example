APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Saat deploy: APP_ENV=production, APP_DEBUG=false (kalau true, stack trace dan
# isi konfigurasi tampil ke publik), APP_URL=https://<alamat-deploy>.
# APP_KEY diisi dengan `php artisan key:generate`, jangan disamakan dengan lokal.

# Pesan validasi 422 ditampilkan apa adanya oleh aplikasi mobile, jadi locale-nya
# harus id. Lihat lang/id/validation.php.
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
#
# Supabase: pakai connection pooler, bukan host direct-connection. Host
# `db.<ref>.supabase.co` hanya punya record IPv6 dan gagal dengan "could not
# translate host name" di jaringan tanpa IPv6. Pooler punya IPv4:
#   DB_HOST=aws-1-<region>.pooler.supabase.com
#   DB_PORT=5432                        # session mode; 6543 = transaction mode
#   DB_USERNAME=postgres.<project-ref>  # bukan 'postgres' saja

# Berbasis file, bukan 'database': endpoint AI hanya butuh cache dan rate
# limiter, jadi tidak perlu bergantung pada database.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI provider untuk AI Simplification + AI Explain This: gemini | grok | mistral | openrouter
AI_PROVIDER=gemini
AI_TIMEOUT=60

# Umur simpanan hasil AI dalam detik. Kosongkan (atau 0) supaya disimpan
# selamanya: permintaan identik tidak perlu menjalankan model lagi, sehingga
# kuota gratis dan emisinya ikut terhemat. Isi hanya kalau memang perlu
# dibatasi. Kalau prompt di AiTextService diubah, naikkan PROMPT_VERSION di
# sana, bukan menurunkan nilai ini.
AI_CACHE_TTL=

# Kunci bersama backend <-> aplikasi mobile, harus sama persis dengan
# EXPO_PUBLIC_API_KEY di mobile-app (.env untuk build lokal, blok "env" di
# eas.json untuk build EAS).
#
# Lokal boleh kosong karena penjagaan mati saat APP_ENV=local. Di produksi wajib
# diisi; kalau kosong, endpoint AI menolak semua permintaan dengan 503.
# Buat nilai acak dengan:  php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
AI_API_KEY=

# Paksa penjagaan menyala/mati tanpa bergantung APP_ENV, mis. saat menguji
# perilaku produksi di mesin lokal:
# AI_REQUIRE_API_KEY=true

# Taksiran jejak karbon tiap permintaan AI. Semua opsional — bawaannya sudah
# dikalibrasi, penjelasan tiap konstanta ada di config/footprint.php.
#
# Yang paling mungkin ingin diubah adalah intensitas karbon listrik datacenter
# (gram CO2e per kWh). Bawaannya 125 mengikuti campuran listrik Google.
# Pembanding: ~480 rata-rata dunia, ~650 jaringan listrik Indonesia.
# FOOTPRINT_GRID_INTENSITY=125
# FOOTPRINT_PUE=1.09
# FOOTPRINT_WH_PER_INPUT_TOKEN=0.00004
# FOOTPRINT_WH_PER_OUTPUT_TOKEN=0.0005

# Gemini - kunci gratis di https://aistudio.google.com/apikey
# Jangan pakai gemini-2.5-flash: sudah ditutup untuk pengguna baru (404).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Grok (xAI) - kunci di https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.5

# Mistral - kunci di https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OpenRouter - kunci di https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
