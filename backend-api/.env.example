APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Pesan validasi 422 diteruskan mentah ke layar pengguna oleh aplikasi mobile,
# jadi locale-nya harus id. Lihat lang/id/validation.php.
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
#
# Kalau memakai Supabase: pakai connection pooler, JANGAN host direct-connection.
# Host `db.<ref>.supabase.co` hanya punya record AAAA (IPv6) dan akan gagal dengan
# "could not translate host name" di jaringan tanpa IPv6. Pooler punya IPv4:
#   DB_HOST=aws-1-<region>.pooler.supabase.com
#   DB_PORT=5432                        # session mode; 6543 = transaction mode
#   DB_USERNAME=postgres.<project-ref>  # bukan 'postgres' saja

# Berbasis file, bukan 'database': endpoint AI hanya butuh cache (hemat kuota LLM
# + rate limiter), jadi jangan digantungkan ke database yang belum tentu ada.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI provider untuk AI Simplification + AI Explain This: gemini | grok | mistral | openrouter
AI_PROVIDER=gemini
AI_TIMEOUT=60
AI_CACHE_TTL=86400

# Gemini - kunci gratis di https://aistudio.google.com/apikey
# Jangan pakai gemini-2.5-flash: sudah ditutup untuk pengguna baru (404).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Grok (xAI) - kunci di https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.5

# Mistral - kunci di https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OpenRouter - kunci di https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
