* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Wajib LF: skrip dengan akhiran baris CRLF ditolak Linux dengan
# "exec format error" saat container start.
*.sh text eol=lf
